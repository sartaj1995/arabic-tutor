# Copy this file to .env and fill in your own key. .env is gitignored.

# Google Cloud Text-to-Speech API key.
# Setup: https://console.cloud.google.com/apis/credentials
#   1. Create/select a GCP project.
#   2. Enable the "Cloud Text-to-Speech API" for that project.
#   3. Create an API key (Credentials -> Create Credentials -> API key).
#   4. (Recommended) Restrict the key to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=

# Optional: override the default voice (must be an ar-XA voice).
# GOOGLE_TTS_VOICE=ar-XA-Wavenet-B
