  "patterns": [
    {
      "id": "broken-plural-place",
      "pattern": "الـ[Broken Plural] + فِي + الـ[Place]",
      "exampleArabic": "الكتب في البيت",
      "exampleTransliteration": "al-kutubu fī l-bayti",
      "exampleEnglish": "The books are in the house.",
      "grammarNote": "Most Arabic plurals are actually 'broken' (جمع تكسير), not sound: the word's internal vowel pattern changes unpredictably instead of adding a suffix like the ـُونَ/ـَاتٌ from level 19. كِتَاب → كُتُب, بَيْت → بُيُوت, وَلَد → أَوْلَاد, رَجُل → رِجَال, قَلَم → أَقْلَام — there's no rule to derive these from, only patterns to recognize with exposure, the same way English has 'child' → 'children' instead of 'childs'. Most common nouns you'll meet from here on use a broken plural, not a sound one.",
      "audio": { "id": "phrase_alkutub_fi_albayt", "text": "الكتب في البيت" },
      "introducedInLevel": 21
    }
  ],
