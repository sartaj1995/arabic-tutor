  "patterns": [
    {
      "id": "relative-clause",
      "pattern": "الـ[Noun] + الذي/التي + [Verb clause]",
      "exampleArabic": "الرجل الذي يعمل في المكتب",
      "exampleTransliteration": "ar-rajulu lladhī yaʿmalu fī l-maktabi",
      "exampleEnglish": "The man who works in the office.",
      "grammarNote": "الَّذِي (masc.) and الَّتِي (fem.) introduce a relative clause — 'who/which/that' — describing a definite noun that comes right before it. Agreement is by the gender of the noun being described, not the clause's own subject: الرَّجُلُ الَّذِي ('the man who...') uses الَّذِي because رَجُل is masculine; الْمَرْأَةُ الَّتِي ('the woman who...') uses الَّتِي because مَرْأَة is feminine, reusing المرأة from level 11. Inside the clause, word order is just a normal verb-subject-object sentence, same as anything else you've built. One rule worth flagging: a relative clause only follows a DEFINITE noun (with الـ). An indefinite noun ('a man who...') is described with no connecting word at all — that construction is outside this course.",
      "audio": { "id": "phrase_alrajul_alladhi_yamalu_almaktab", "text": "الرجل الذي يعمل في المكتب" },
      "introducedInLevel": 55
    }
  ],
