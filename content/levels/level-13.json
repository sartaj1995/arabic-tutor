  "patterns": [
    {
      "id": "where-are-you-going",
      "pattern": "أَيْنَ + [Verb, 'you' form]؟",
      "exampleArabic": "أَيْنَ تَذْهَبِينَ؟",
      "exampleTransliteration": "ayna tadhhabīna?",
      "exampleEnglish": "Where are you (fem.) going?",
      "grammarNote": "This completes the present-tense set for ذهب across levels 12–13 (skipping dual and the -تم/-هم plural forms for now, which come later): أَذْهَبُ (I), تَذْهَبُ (you m. / she), تَذْهَبِينَ (you f.), يَذْهَبُ (he), نَذْهَبُ (we). Worth flagging: تَذْهَبُ is a genuine homograph — 'you (masc.) go' and 'she goes' are spelled and pronounced identically. Only the subject (stated or implied by context) tells them apart, e.g. هِيَ تَذْهَبُ إِلَى الْجَامِعَةِ ('she goes to the university') vs أَنْتَ تَذْهَبُ إِلَى السُّوقِ ('you go to the market').",
      "audio": { "id": "phrase_ayna_tadhhabiina", "text": "أَيْنَ تَذْهَبِينَ؟" },
      "introducedInLevel": 13
    }
  ],
