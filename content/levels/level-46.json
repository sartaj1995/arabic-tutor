  "patterns": [
    {
      "id": "place-preposition",
      "pattern": "[Noun] + تَحْتَ + الـ[Noun]",
      "exampleArabic": "القلم تحت الكتاب",
      "exampleTransliteration": "al-qalamu taḥta l-kitābi",
      "exampleEnglish": "The pen is under the book.",
      "grammarNote": "These words are all built the same way idafa was in level 31: تَحْتَ ('under') literally means something like 'the underside of', and is always followed by a genitive noun — تَحْتَ الْكِتَابِ is structurally 'the-underside-of the-book'. That's why they end in fatḥa (تَحْتَ, فَوْقَ, أَمَامَ...) rather than looking like ordinary nouns — they're functioning adverbially, the same accusative role you saw with أَمْسِ and غَدًا in level 22.",
      "audio": { "id": "phrase_alqalam_tahta_alkitaab", "text": "القلم تحت الكتاب" },
      "introducedInLevel": 46
    }
  ],
