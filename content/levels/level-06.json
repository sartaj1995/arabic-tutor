  "patterns": [
    {
      "id": "what-is-this",
      "pattern": "مَا + [Demonstrative]؟",
      "exampleArabic": "مَا هَذَا؟",
      "exampleTransliteration": "mā hādhā؟",
      "exampleEnglish": "What is this?",
      "grammarNote": "Question words go at the very start of the sentence; the rest follows normal word order. There's no extra helper verb like English 'do/does' — مَا هَذَا؟ is literally 'what this?'.",
      "audio": { "id": "phrase_maa_haadhaa", "text": "مَا هَذَا؟" },
      "introducedInLevel": 6
    }
  ],
