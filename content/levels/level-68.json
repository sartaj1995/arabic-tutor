  "patterns": [
    {
      "id": "go-by-vehicle",
      "pattern": "أَذْهَبُ + بِالـ[Vehicle]",
      "exampleArabic": "أذهب بالقطار",
      "exampleTransliteration": "adhhabu bi-l-qiṭāri",
      "exampleEnglish": "I go by train.",
      "grammarNote": "Reuses the بِالـ ('by [vehicle]') structure level 43 introduced with أُسَافِرُ بِالطَّائِرَةِ ('I travel by plane'), just with the everyday verb أَذْهَبُ ('I go', level 12) and a new set of vocabulary: قِطَار ('train'), حَافِلَة ('bus'), دَرَّاجَة ('bicycle'), مَحَطَّة ('station'), and تَذْكِرَة ('ticket') — everything you need to build your own 'I go to the station and wait for the train' sentences using verbs from levels 63 and 67 too.",
      "audio": { "id": "phrase_adhhab_bialqitaar", "text": "أذهب بالقطار" },
      "introducedInLevel": 68
    }
  ],
