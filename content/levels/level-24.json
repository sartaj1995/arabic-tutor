  "patterns": [
    {
      "id": "past-read-question",
      "pattern": "هَلْ + [Past verb] + الـ[Object] + [Time word]؟",
      "exampleArabic": "هل قرأت الجريدة اليوم",
      "exampleTransliteration": "hal qaraʾta l-jarīdata l-yawma",
      "exampleEnglish": "Did you (masc.) read the newspaper today?",
      "grammarNote": "هَلْ turns any statement into a yes/no question just by placing it at the very front — no word order change, unlike English 'did you read?'. The same هَلْ works for present and past tense alike. Answer with نَعَمْ or لَا, both known since level 1. قرأ conjugates exactly like ذهب in the past tense — its root-final hamza just changes spelling 'seat' depending on the surrounding vowels (the same hamza rules from level 8), so قَرَأْتُ، قَرَأْتَ، قَرَأْتِ، and قَرَأَتْ all collapse to قرأت without diacritics, same collision pattern as ذهب.",
      "audio": { "id": "phrase_hal_qaraata_aljareeda_alyawm", "text": "هل قرأت الجريدة اليوم" },
      "introducedInLevel": 24
    }
  ],
