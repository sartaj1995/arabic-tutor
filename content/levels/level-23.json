  "patterns": [
    {
      "id": "past-want-object",
      "pattern": "[Time word] + [Past verb] + [Indefinite Object, accusative]",
      "exampleArabic": "أمس أردت قهوة",
      "exampleTransliteration": "amsi aradtu qahwatan",
      "exampleEnglish": "Yesterday I wanted coffee.",
      "grammarNote": "أراد is a 'hollow' verb — its middle root letter is a weak و, which shows up as a long ا only when a vowel follows. Before a consonant-starting suffix it disappears: أَرَدْتُ, not أَرَادْتُ. Before a vowel-starting suffix it stays: أَرَادَ (he), أَرَادَتْ (she). That difference actually helps here — unlike ذهب last level, أراد's هو and هي forms (أَرَادَ / أَرَادَتْ) stay visually distinct even without diacritics, because the vowel shortening is a real letter change, not just a missing vowel mark. Only I/you (masc.)/you (fem.) still collapse to the same أردت.",
      "audio": { "id": "phrase_amsi_aradtu_qahwatan", "text": "أمس أردت قهوة" },
      "introducedInLevel": 23
    }
  ],
