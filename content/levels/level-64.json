  "patterns": [
    {
      "id": "object-suffix",
      "pattern": "[Present-tense verb] + -هُ / -هَا / -نِي",
      "exampleArabic": "المدرس يعلمني",
      "exampleTransliteration": "al-mudarrisu yuʿallimunī",
      "exampleEnglish": "The teacher teaches me.",
      "grammarNote": "The same suffixes that mark possession on a noun (بَيْتُهُ 'his house', بَيْتُهَا 'her house', level 9) attach directly to a present-tense verb to mark its direct OBJECT instead: أُعَلِّمُهُ isn't 'my teach' — it's 'I teach him'. -هُ and -هَا work identically in both roles. 'Me' is the one exception: as a possessive it's -ي (كِتَابِي, 'my book'), but as a verb's object it's -نِي (يُعَلِّمُنِي, 'he teaches me') — a real, deliberate difference that keeps the two roles from sounding identical. This pattern works with any verb you already know: تَذْهَبُونَ has no object, but a transitive verb like عَلَّمَ or أَرْسَلَ (level 56) can take any of these three suffixes the same way.",
      "audio": { "id": "phrase_almudarris_yuallimuni", "text": "المدرس يعلمني" },
      "introducedInLevel": 64
    }
  ],
