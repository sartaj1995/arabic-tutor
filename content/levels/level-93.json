  "patterns": [
    {
      "id": "cant-find-key",
      "pattern": "لَا + [Verb] + الـ[Noun]",
      "exampleArabic": "لا أجد المفتاح",
      "exampleTransliteration": "lā ajidu l-miftāḥa",
      "exampleEnglish": "I don't find the key.",
      "grammarNote": "وَجَدَ ('to find') introduces a FOURTH weak-verb type — 'assimilated' (مِثَال) roots, whose FIRST letter is weak (و or ي) and disappears entirely in the present tense: وَجَدَ → يَجِدُ, not يَوْجِدُ. You've now met all four: hollow (أَرَادَ/نَامَ, middle letter), defective (مَشَى/أَعْطَى, final letter), geminate (أَحَبَّ, doubled letter), and assimilated (وَجَدَ, first letter). Also new here: لَا + a present-tense verb is how Arabic negates the present tense — distinct from لَيْسَ (equational sentences, level 10), لَمْ (past, level 32), and لَنْ (future, level 32). No special conjugation is needed; لَا simply precedes the ordinary present-tense verb you already know.",
      "audio": { "id": "phrase_laa_ajidu_almiftaah", "text": "لا أجد المفتاح" },
      "introducedInLevel": 93
    }
  ],
