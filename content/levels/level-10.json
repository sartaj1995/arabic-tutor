  "patterns": [
    {
      "id": "i-am-not-adjective",
      "pattern": "[Negation particle, conjugated] + [Adjective in accusative]",
      "exampleArabic": "لَسْتُ سَعِيدًا",
      "exampleTransliteration": "lastu saʿīdan",
      "exampleEnglish": "I am not happy. (male speaker)",
      "grammarNote": "لَيْسَ (laysa) negates equational (verb-less) sentences. It's a 'defective verb' that conjugates by person like a past-tense verb even though its meaning is present tense: لَسْتُ (I am not), لَسْتَ / لَسْتِ (you m./f. are not), لَيْسَ (he is not), لَيْسَتْ (she is not). The adjective that follows switches to the accusative case ending -an (سَعِيدًا, not سَعِيدٌ).",
      "audio": { "id": "phrase_lastu_saeedan", "text": "لَسْتُ سَعِيدًا" },
      "introducedInLevel": 10
    }
  ],
