  "patterns": [
    {
      "id": "nisba-adjective",
      "pattern": "[Pronoun] + [Noun/Place] + ـِيّ",
      "exampleArabic": "أنا مصري",
      "exampleTransliteration": "anā miṣriyy",
      "exampleEnglish": "I am Egyptian.",
      "grammarNote": "Adding ـِيّ (with a shadda) to almost any place name or noun turns it into a 'nisba' adjective meaning 'relating to X': مِصْر (Egypt) → مِصْرِيّ ('Egyptian'), أَمْرِيكَا (America) → أَمْرِيكِيّ, عَرَب (Arabs) → عَرَبِيّ. This is one of the most productive patterns in Arabic — it also builds words for religions, professions, and fields of study, not just nationalities. The feminine adds ة on top of the ي: مِصْرِيَّة ('Egyptian', fem.).",
      "audio": { "id": "phrase_ana_misri", "text": "أنا مصري" },
      "introducedInLevel": 47
    }
  ],
