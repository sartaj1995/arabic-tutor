  "patterns": [
    {
      "id": "compound-numbers",
      "pattern": "[Unit 1–9] + وَ + [Ten]",
      "exampleArabic": "خمسة وثلاثون",
      "exampleTransliteration": "khamsatun wa-thalāthūna",
      "exampleEnglish": "thirty-five (literally 'five and thirty')",
      "grammarNote": "Now that you have units (levels 8, 14) and tens (levels 53, 61), every number from 21 to 99 is just [unit] + وَ + [ten] — reusing level-20's وَ exactly as before. Order is the reverse of English: the unit comes FIRST, the ten second: خَمْسَةٌ وَثَلَاثُونَ is literally 'five and thirty' = 35. No new vocabulary is needed for 21–99 beyond what you already have. مِائَة ('100') is the one exception to the -ُونَ tens pattern — and unlike the tens, it takes a singular noun after it (مِائَةُ كِتَابٍ, 'a hundred books', literally 'a hundred of book'), an idafa-like structure similar to level 31 that's flagged here but not drilled.",
      "audio": { "id": "phrase_khamsa_wa_thalathuun", "text": "خمسة وثلاثون" },
      "introducedInLevel": 61
    }
  ],
