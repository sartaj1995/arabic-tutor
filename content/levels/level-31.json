  "patterns": [
    {
      "id": "idafa-possession",
      "pattern": "[Noun, no ال] + الـ[Noun, definite]",
      "exampleArabic": "مفتاح البيت كبير",
      "exampleTransliteration": "miftāḥu l-bayti kabīrun",
      "exampleEnglish": "The house key is big.",
      "grammarNote": "This is 'idafa' (الإضافة) — Arabic's way of joining two nouns into a possessive phrase, with no word for 'of' at all. The first noun (مِفْتَاح) takes NO ال and NO tanwīn, even though it's meaning-wise definite ('the key'); the second noun (الْبَيْت) carries the ال instead, and the whole phrase's definiteness comes from it. Compare to the pronoun-suffix possession from level 9 (بَيْتِي 'my house') — idafa is the noun-noun version of that same idea: بَيْتُ الرَّجُلِ ('the man's house', literally 'house-of the-man'). You can even chain idafa: مِفْتَاحُ بَيْتِ الرَّجُلِ ('the key of the man's house') — only the very last noun in the chain gets the ال.",
      "audio": { "id": "phrase_miftaah_albayt_kabeer", "text": "مفتاح البيت كبير" },
      "introducedInLevel": 31
    }
  ],
