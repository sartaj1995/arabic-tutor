    {
      "id": "travel-by",
      "pattern": "[Verb] + بِالـ[Instrument]",
      "exampleArabic": "أسافر بالطائرة",
      "exampleTransliteration": "usāfiru bi-ṭ-ṭāʾirati",
      "exampleEnglish": "I travel by plane.",
      "grammarNote": "سافر is the first verb you've met outside the basic فَعَلَ pattern (Form I) — it's Form III (فَاعَلَ), marked by a long ا after the first root letter: سَافَرَ, not سَفَرَ. Form III present-tense prefixes take DAMMA, not fatha: أُسَافِرُ, تُسَافِرُ, تُسَافِرِينَ, يُسَافِرُ, نُسَافِرُ — otherwise the same six-pronoun template you already know. بِالطَّائِرَةِ ('by plane') reuses بِ ('with/by', level 34) exactly the way it introduced بِالْقَلَمِ.",
      "audio": { "id": "phrase_usaafiru_bialtaaira", "text": "أسافر بالطائرة" },
      "introducedInLevel": 43
    }
  ],
