  "patterns": [
    {
      "id": "go-to-place",
      "pattern": "[Verb] + إِلَى + الـ[Place, genitive]",
      "exampleArabic": "أَذْهَبُ إِلَى الْمَدْرَسَةِ",
      "exampleTransliteration": "adhhabu ilā l-madrasati",
      "exampleEnglish": "I go to school.",
      "grammarNote": "Present-tense MSA verbs conjugate with a prefix for the subject: أَ- (I), تَ- (you/she), يَ- (he), نَ- (we), attached to a verb stem (here ‑ذْهَب‑), usually with a -ُ ending. إِلَى ('to/towards') is a preposition that puts the following noun in the genitive case, shown by a -ِ ending — so الْمَدْرَسَةُ ('the school', nominative) becomes الْمَدْرَسَةِ after إِلَى.",
      "audio": { "id": "phrase_adhhabu_ilaa_madrasa", "text": "أَذْهَبُ إِلَى الْمَدْرَسَةِ" },
      "introducedInLevel": 12
    }
  ],
