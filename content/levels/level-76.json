  "patterns": [
    {
      "id": "object-suffix-2",
      "pattern": "[Present-tense verb] + -كَ / -نَا / -هُمْ",
      "exampleArabic": "المدرس يعلمنا",
      "exampleTransliteration": "al-mudarrisu yuʿallimunā",
      "exampleEnglish": "The teacher teaches us.",
      "grammarNote": "Three more attached object pronouns, continuing level 64's -هُ/-هَا/-نِي: -كَ ('you', masc. — أُعَلِّمُكَ), -نَا ('us' — يُعَلِّمُنَا, the same -نَا you've seen on possessed nouns), and -هُمْ ('them' — أُعَلِّمُهُمْ, matching هُمْ the pronoun exactly). Together with level 64 you now have six of Arabic's object-suffix pronouns; -كِ ('you', fem.), -كُمْ ('you', plural), and -هُنَّ ('them', fem.) follow the identical pattern and are left as a natural extension, the same 'kept light' call made for the dual and أَنْتُنَّ.",
      "audio": { "id": "phrase_almudarris_yuallimuna", "text": "المدرس يعلمنا" },
      "introducedInLevel": 76
    }
  ],
