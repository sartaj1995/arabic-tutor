  "patterns": [
    {
      "id": "hungry-want-food",
      "pattern": "أَنَا + [Adjective] + وَ + أُرِيدُ + [Noun]",
      "exampleArabic": "أنا جائع وأريد طعاما",
      "exampleTransliteration": "anā jāʾiʿun wa-urīdu ṭaʿāman",
      "exampleEnglish": "I am hungry and I want food.",
      "grammarNote": "Nothing new grammatically here — جَائِع ('hungry') is a plain equational sentence like سَعِيد/حَزِين (levels 7 and 49): أَنَا + adjective, no verb 'to be' needed. أُرِيدُ ('I want', level 15) still takes its object directly, no preposition. This level is otherwise vocabulary-only: مَطْعَم ('restaurant'), لَحْم ('meat'), سَمَك ('fish'), and أُرُزّ ('rice') to build your own food sentences with.",
      "audio": { "id": "phrase_ana_jaaia_wa_ureedu_taaman", "text": "أنا جائع وأريد طعاما" },
      "introducedInLevel": 58
    }
  ],
