    {
      "id": "take-the-book",
      "pattern": "[Verb] + الـ[Noun]",
      "exampleArabic": "آخذ الكتاب",
      "exampleTransliteration": "ākhudhu l-kitāba",
      "exampleEnglish": "I take the book.",
      "grammarNote": "أَخَذَ ('to take') has the exact same hamza-initial pattern as أَكَلَ (level 25): the 'I' form fuses two adjacent hamzas into a single alif-madda (آ) — آخُذُ, not أَأْخُذُ. The rest of the paradigm behaves normally: تَأْخُذُ, تَأْخُذِينَ, يَأْخُذُ, نَأْخُذُ.",
      "audio": { "id": "phrase_aakhudhu_alkitaab", "text": "آخذ الكتاب" },
      "introducedInLevel": 95
    }
  ],
