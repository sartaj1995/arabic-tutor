  "patterns": [
    {
      "id": "sleep-at-home",
      "pattern": "[Verb] + فِي الـ[Place]",
      "exampleArabic": "أنام في البيت",
      "exampleTransliteration": "anāmu fī l-bayti",
      "exampleEnglish": "I sleep in the house.",
      "grammarNote": "نَامَ ('to sleep') is only the second 'hollow' verb you've met — a root whose middle letter (here و) turns into a long vowel instead of staying a consonant, the same irregularity أَرَادَ (level 15/23) has. Unlike أَرَادَ though, نَامَ keeps the SAME long ا vowel in both the past and the present tense: نَامَ / يَنَامُ, not يَنُومُ — hollow verbs are memorized individually by which vowel they keep, not derived from a single rule. Otherwise it's a completely ordinary Form I present tense: أَنَامُ, تَنَامُ, تَنَامِينَ, يَنَامُ, نَنَامُ.",
      "audio": { "id": "phrase_anamu_fi_albayt", "text": "أنام في البيت" },
      "introducedInLevel": 66
    }
  ],
