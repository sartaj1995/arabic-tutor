  "patterns": [
    {
      "id": "i-am-adjective",
      "pattern": "[Pronoun] + [Adjective]",
      "exampleArabic": "أَنَا سَعِيدٌ",
      "exampleTransliteration": "anā saʿīdun",
      "exampleEnglish": "I am happy. (spoken by a male)",
      "grammarNote": "As with nouns, Arabic needs no separate word for 'am/is/are': a pronoun directly followed by an adjective is a full sentence. Adjectives must agree in gender with the subject — a woman says أَنَا سَعِيدَةٌ (anā saʿīdatun), adding ة (tāʾ marbūṭa) to the adjective.",
      "audio": { "id": "phrase_ana_saeedun", "text": "أَنَا سَعِيدٌ" },
      "introducedInLevel": 7
    }
  ],
