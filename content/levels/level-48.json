  "patterns": [
    {
      "id": "can-subordinate",
      "pattern": "[يستطيع form] + أَنْ + [Present-tense verb]",
      "exampleArabic": "أستطيع أن أذهب",
      "exampleTransliteration": "astaṭīʿu an adhhaba",
      "exampleEnglish": "I can go.",
      "grammarNote": "يستطيع ('to be able to/can') is a longer Form X verb (root ط-و-ع), but conjugates with the exact same six-pronoun prefix template you already know. أَنْ ('that/to') connects it to a second verb — and that second verb technically shifts into the subjunctive mood (منصوب), which for a regular verb just changes the final vowel (أَذْهَبُ → أَذْهَبَ), invisible here since diacritics aren't shown. So exactly like لَمْ and لَنْ, you don't need new vocabulary for the verb after أَنْ — reuse the present-tense form you already know.",
      "audio": { "id": "phrase_astatiu_an_adhhab", "text": "أستطيع أن أذهب" },
      "introducedInLevel": 48
    }
  ],
