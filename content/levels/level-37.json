  "patterns": [
    {
      "id": "comparative-min",
      "pattern": "[Noun] + [Comparative] + مِنْ + [Noun]",
      "exampleArabic": "بيتي أكبر من بيتك",
      "exampleTransliteration": "baytī akbaru min baytika",
      "exampleEnglish": "My house is bigger than your house.",
      "grammarNote": "Comparatives use the exact same أَفْعَل pattern you already saw for colors in level 16 — أَكْبَر ('bigger', from كَبِير) is built the same way as أَحْمَر ('red'). Add مِنْ ('than', a new word here — careful, it looks identical to مَنْ 'who' from level 6 once diacritics are stripped, the same kind of ambiguity you saw in the past tense) after the comparative to name what's being compared to. For a superlative ('the biggest'), just make it definite with الـ and drop مِنْ entirely, since there's nothing left to compare to: الْبَيْتُ الْأَكْبَرُ ('the biggest house').",
      "audio": { "id": "phrase_bayti_akbar_min_baytika", "text": "بيتي أكبر من بيتك" },
      "introducedInLevel": 37
    }
  ],
