  "patterns": [
    {
      "id": "dual-agreement",
      "pattern": "الـ[Dual Noun] + [Dual Adjective]",
      "exampleArabic": "الولدان صغيران",
      "exampleTransliteration": "al-waladāni ṣaghīrāni",
      "exampleEnglish": "The two boys are small.",
      "grammarNote": "Arabic marks exactly TWO of something with its own ending, separate from both singular and plural: -َانِ (waladāni 'two boys'), not the broken or sound plurals from levels 19/21. Adjectives agree with the same dual ending: صَغِيرَانِ ('small', dual), matching وَلَدَانِ the way plural adjectives matched plural nouns before. This -َانِ form is used for the subject of a sentence; there's a second dual ending, -َيْنِ, used elsewhere (after prepositions, as an object) that isn't drilled yet — for now, just recognize that a noun ending in ـَانِ or ـَيْنِ means 'exactly two'.",
      "audio": { "id": "phrase_alwaladaan_saghiiraan", "text": "الولدان صغيران" },
      "introducedInLevel": 38
    }
  ],
