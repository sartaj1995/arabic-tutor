    {
      "id": "sa-future",
      "pattern": "سَ + [Present-tense verb]",
      "exampleArabic": "سأذهب إلى السوق غدا",
      "exampleTransliteration": "sa-adhhabu ilā s-sūqi ghadan",
      "exampleEnglish": "I will go to the market tomorrow.",
      "grammarNote": "Like لَمْ and لَنْ (level 32), the future doesn't need new verb forms — it just pairs with the present tense you already know. سَ attaches directly to the verb with no space, like وَ and بِ: سَأَذْهَبُ, not سَ أَذْهَبُ. سَوْفَ is the same meaning as a separate word, slightly more formal or emphatic — سَوْفَ أَذْهَبُ and سَأَذْهَبُ both mean 'I will go'. You now have all three futures: سَـ/سَوْفَ ('will'), لَنْ ('will not', level 32).",
      "audio": { "id": "phrase_sa_adhhab_alsuuq_ghadan", "text": "سأذهب إلى السوق غدا" },
      "introducedInLevel": 41
    }
  ],
