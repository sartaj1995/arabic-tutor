  "patterns": [
    {
      "id": "nonhuman-plural-agreement",
      "pattern": "الـ[Non-human Plural] + [Fem. singular Adjective]",
      "exampleArabic": "الجبال جميلة",
      "exampleTransliteration": "al-jibālu jamīlatun",
      "exampleEnglish": "The mountains are beautiful.",
      "grammarNote": "Non-human plurals (places, objects, animals — anything that isn't a group of people) take FEMININE SINGULAR agreement, no matter the noun's own gender: الْجِبَالُ (a masculine-singular-based plural) pairs with جَمِيلَةٌ (feminine singular), not a masculine plural form. This rule applies to any non-human plural, broken or sound alike. Human plurals (like مُدَرِّسُونَ from level 19) agree normally instead — this is one of MSA's most-missed rules for learners, so it's worth drilling deliberately.",
      "audio": { "id": "phrase_aljibaal_jameela", "text": "الجبال جميلة" },
      "introducedInLevel": 27
    }
  ],
