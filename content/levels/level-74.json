  "patterns": [
    {
      "id": "this-is-cheap",
      "pattern": "هَذَا + [Adjective]",
      "exampleArabic": "هذا رخيص",
      "exampleTransliteration": "hādhā rakhīṣun",
      "exampleEnglish": "This is cheap.",
      "grammarNote": "Nothing new grammatically — هَذَا + adjective is the same equational sentence from level 5. نُقُودٌ ('money') is a plural-only noun, the way 'clothes' works in English — there's no everyday singular 'a money'. سِعْرٌ ('a price') and دُكَّانٌ ('a shop') round out the set for building your own shopping sentences: دُكَّانٌ رَخِيصٌ ('a cheap shop'), سِعْرُهُ رَخِيصٌ ('its price is cheap', reusing the -ُهُ suffix from level 9).",
      "audio": { "id": "phrase_haadhaa_rakhees", "text": "هذا رخيص" },
      "introducedInLevel": 74
    }
  ],
