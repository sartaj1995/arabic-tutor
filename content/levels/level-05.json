  "patterns": [
    {
      "id": "this-is-noun",
      "pattern": "[Demonstrative] + [Indefinite Noun]",
      "exampleArabic": "هَذَا بَيْتٌ",
      "exampleTransliteration": "hādhā baytun",
      "exampleEnglish": "This is a house.",
      "grammarNote": "Arabic has no separate word for 'is' in a simple present-tense statement — placing a demonstrative directly before a noun forms a complete sentence. The final -un ending (tanwīn / nunation) marks the noun as indefinite ('a house', not 'the house'); it's frequently dropped in casual speech.",
      "audio": { "id": "phrase_haadhaa_baytun", "text": "هَذَا بَيْتٌ" },
      "introducedInLevel": 5
    }
  ],
