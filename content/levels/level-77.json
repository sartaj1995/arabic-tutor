    {
      "id": "love-coffee",
      "pattern": "[Verb] + الـ[Noun]",
      "exampleArabic": "أحب القهوة",
      "exampleTransliteration": "uḥibbu l-qahwata",
      "exampleEnglish": "I love coffee.",
      "grammarNote": "أَحَبَّ ('to like/love') is Form IV of a 'geminate' (doubled) root — ح-ب-ب, whose last two letters are identical. Rather than spelling them out separately, Arabic always contracts them into one letter marked with a shadda: حَبَّ, not حَبَبَ — and with the Form IV prefix, أَحَبَّ. The present tense keeps the same contraction: يُحِبُّ, not the spelled-out يُحْبِبُ you might expect. This is a third weak-verb pattern, alongside hollow (أَرَادَ/نَامَ) and defective (مَشَى, level 75) roots — geminate roots contract rather than losing a letter or turning into a vowel.",
      "audio": { "id": "phrase_uhibbu_alqahwa", "text": "أحب القهوة" },
      "introducedInLevel": 77
    }
  ],
