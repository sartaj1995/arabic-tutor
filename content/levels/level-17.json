  "patterns": [
    {
      "id": "today-is",
      "pattern": "الْيَوْمُ + هُوَ + [Day]",
      "exampleArabic": "اليوم هو الجمعة",
      "exampleTransliteration": "al-yawmu huwa l-jumuʿatu",
      "exampleEnglish": "Today is Friday.",
      "grammarNote": "الْيَوْمُ ('the day') is used idiomatically to mean 'today'. Normally a definite subject can be followed directly by an indefinite predicate (level 11), but here BOTH sides are definite (الْيَوْمُ and الْجُمُعَةُ) — without something in between, that would misread as one long phrase ('Friday's day'). MSA fixes this by inserting a 'pronoun of separation' (هُوَ for masc., هِيَ for fem.) between two definite parts of an equational sentence. Also note: ث and س in الثُّلَاثَاءُ/السَّبْتُ are sun letters (level 11) — pronounced ath-thulāthāʾu, as-sabtu.",
      "audio": { "id": "phrase_alyawm_huwa_aljumua", "text": "اليوم هو الجمعة" },
      "introducedInLevel": 17
    }
  ],
