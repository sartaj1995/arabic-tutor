  "patterns": [
    {
      "id": "plural-pronoun-verb",
      "pattern": "[Plural pronoun] + [Verb ending in ـُونَ / ـْنَ]",
      "exampleArabic": "أنتم تذهبون إلى الجامعة",
      "exampleTransliteration": "antum tadhhabūna ilā l-jāmiʿati",
      "exampleEnglish": "You (plural) go to the university.",
      "grammarNote": "50 levels in, you've only had six pronouns (أَنَا, أَنْتَ, أَنْتِ, هُوَ, هِيَ, نَحْنُ) — this level fills in the plural side (skipping the dual, kept light since level 38): أَنْتُمْ ('you', plural masc./mixed) and هُنَّ ('they', fem.) join هُمْ (level 7, 'they' masc./mixed, vocab-only until now). Their verb forms follow a pattern you've already half-seen: the masc. plural ending ـُونَ echoes the sound-plural noun ending from level 19 (مُدَرِّسُونَ), while the fem. plural ending ـْنَ has no long vowel at all — تَذْهَبُونَ (you-pl. go) / يَذْهَبُونَ (they-masc. go) / يَذْهَبْنَ (they-fem. go). أَنْتُنَّ ('you', fem. plural) is the one pronoun still deliberately left out, the same 'kept light' call made for the dual.",
      "audio": { "id": "phrase_antum_tadhhabuuna_aljaamiaa", "text": "أنتم تذهبون إلى الجامعة" },
      "introducedInLevel": 51
    }
  ],
