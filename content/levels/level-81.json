  "patterns": [
    {
      "id": "know-the-language",
      "pattern": "[Verb] + الـ[Noun] + الـ[Adjective]",
      "exampleArabic": "أعرف اللغة العربية",
      "exampleTransliteration": "aʿrifu l-lughata l-ʿarabiyyata",
      "exampleEnglish": "I know the Arabic language.",
      "grammarNote": "عَرَفَ ('to know') is an ordinary Form I verb — no irregularity, just useful vocabulary: أَعْرِفُ, تَعْرِفُ, تَعْرِفِينَ, يَعْرِفُ, نَعْرِفُ. لُغَة ('a language') pairs naturally with الْعَرَبِيَّة, the FEMININE form of عَرَبِيّ (level 47, 'Arab/Arabic') — adjectives agree in gender with the noun they describe, and since لُغَة is feminine, its adjective takes the ةـ ending: عَرَبِيَّة, not the masculine عَرَبِيّ you met first.",
      "audio": { "id": "phrase_aarifu_allugha_alarabiyya", "text": "أعرف اللغة العربية" },
      "introducedInLevel": 81
    }
  ],
