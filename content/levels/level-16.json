  "patterns": [
    {
      "id": "color-agreement",
      "pattern": "الـ[Fem. Noun] + [Fem. Color]",
      "exampleArabic": "السيارة حمراء",
      "exampleTransliteration": "as-sayyāratu ḥamrāʾu",
      "exampleEnglish": "The car is red.",
      "grammarNote": "Colors follow a special 'أَفْعَل' pattern and have their own feminine form instead of the usual ة ending: أَحْمَر (red, masc.) → حَمْرَاء (red, fem.), أَبْيَض (white) → بَيْضَاء, أَسْوَد (black) → سَوْدَاء, أَزْرَق (blue) → زَرْقَاء, أَخْضَر (green) → خَضْرَاء, أَصْفَر (yellow) → صَفْرَاء. سَيَّارَة ('car', from level 3) is feminine, so its color adjective must also be feminine: حَمْرَاء, not أَحْمَر.",
      "audio": { "id": "phrase_sayyaara_hamraa", "text": "السيارة حمراء" },
      "introducedInLevel": 16
    }
  ],
