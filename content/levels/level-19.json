  "patterns": [
    {
      "id": "plural-in-place",
      "pattern": "الـ[Sound Masc. Plural] + فِي + الـ[Place]",
      "exampleArabic": "المدرسون في المدرسة",
      "exampleTransliteration": "al-mudarrisūna fī l-madrasati",
      "exampleEnglish": "The teachers are in the school.",
      "grammarNote": "Two regular ('sound') plural patterns: masculine nouns usually add ـُونَ (mudarris → mudarrisūna); feminine nouns (including ones ending in ة, which is dropped first) usually add ـَاتٌ (mudarrisa → mudarrisāt, sayyāra → sayyārāt). Many nouns instead take an irregular 'broken' plural with no predictable pattern — those come later. Careful: مُدَرِّسَة ('teacher', fem.) and مَدْرَسَة ('school') look and sound almost identical but are unrelated words — only the middle vowel pattern differs.",
      "audio": { "id": "phrase_almudarrisuun_fi_almadrasa", "text": "المدرسون في المدرسة" },
      "introducedInLevel": 19
    }
  ],
