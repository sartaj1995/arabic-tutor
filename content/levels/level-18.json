  "patterns": [
    {
      "id": "read-object",
      "pattern": "[Subject] + [Verb] + [Indefinite Object, accusative]",
      "exampleArabic": "هو يقرأ جريدة",
      "exampleTransliteration": "huwa yaqraʾu jarīdatan",
      "exampleEnglish": "He is reading a newspaper.",
      "grammarNote": "قرأ ('to read') has a root ending in hamza (ء), which changes seat depending on the vowel around it — compare تَقْرَأُ (you m. / she) with تَقْرَئِينَ (you f.), where the hamza sits on a ي before the -īna ending. Same accusative -an object pattern as level 15's أُرِيدُ قَهْوَةً: جَرِيدَةً here.",
      "audio": { "id": "phrase_huwa_yaqrau_jareedatan", "text": "هو يقرأ جريدة" },
      "introducedInLevel": 18
    }
  ],
