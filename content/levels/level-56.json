  "patterns": [
    {
      "id": "send-to",
      "pattern": "[Verb] + [Object] + إِلَى + الـ[Recipient]",
      "exampleArabic": "أرسل رسالة إلى المكتب",
      "exampleTransliteration": "ursilu risālatan ilā l-maktabi",
      "exampleEnglish": "I send a letter to the office.",
      "grammarNote": "أَرْسَلَ ('to send') is Form IV (أَفْعَلَ) — marked by a hamza at the start of the past-tense stem: أَرْسَلَ, not رَسَلَ. Like Forms II and III, Form IV's present-tense prefix takes damma: أُرْسِلُ, تُرْسِلُ, تُرْسِلِينَ, يُرْسِلُ, نُرْسِلُ. Notice the stem shape differs from both earlier forms: Form II doubles the middle letter (عَلَّمَ → يُعَلِّمُ, level 54), Form III lengthens the first vowel (سَافَرَ → يُسَافِرُ, level 43), and Form IV instead has a plain sukun-kasra stem: يُرْسِلُ. Three of the ten verb forms are now covered outside the base Form I (فَعَلَ): III (سافر), II (علّم), IV (أرسل). إِلَى reuses level 12 exactly as before.",
      "audio": { "id": "phrase_ursilu_risaala_ilaa_almaktab", "text": "أرسل رسالة إلى المكتب" },
      "introducedInLevel": 56
    }
  ],
