  "patterns": [
    {
      "id": "eat-object",
      "pattern": "[Verb] + الـ[Object, accusative]",
      "exampleArabic": "آكل الخبز",
      "exampleTransliteration": "ākulu l-khubza",
      "exampleEnglish": "I eat bread.",
      "grammarNote": "أكل ('to eat') is a hamzated-initial verb — its root starts with ء. In the 'I' form, the verb's own root hamza would collide with the prefix hamza (أَ + أْكُلُ) and the two merge into one long ا: آكُلُ, not أَأْكُلُ. Every other person is completely regular, matching ذهب's exact prefix pattern: تَأْكُلُ، تَأْكُلِينَ، يَأْكُلُ، نَأْكُلُ. الْخُبْزَ here is definite but still means 'bread' generically — Arabic often uses ال for food and other mass nouns where English uses no article at all.",
      "audio": { "id": "phrase_aakulu_alkhubz", "text": "آكل الخبز" },
      "introducedInLevel": 25
    }
  ],
