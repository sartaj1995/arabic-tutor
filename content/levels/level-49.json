    {
      "id": "feeling-today",
      "pattern": "أَنَا + [Feeling] + الْيَوْمَ",
      "exampleArabic": "أنا حزين اليوم",
      "exampleTransliteration": "anā ḥazīnun al-yawma",
      "exampleEnglish": "I am sad today.",
      "grammarNote": "Arabic distinguishes paternal from maternal relatives systematically, not just for uncles: عَمّ is specifically your father's brother, خَال your mother's brother — English 'uncle' collapses a distinction Arabic always keeps (and extends to aunts and cousins too, if you keep going). اليوم reuses level 24's word — 'today' works as a time adverb after any adjective of feeling, not just with verbs.",
      "audio": { "id": "phrase_ana_hazeen_alyawm", "text": "أنا حزين اليوم" },
      "introducedInLevel": 49
    }
  ],
