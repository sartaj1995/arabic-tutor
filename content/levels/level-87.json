  "patterns": [
    {
      "id": "give-you-book",
      "pattern": "[Verb] + -كَ + الـ[Noun]",
      "exampleArabic": "أعطيك الكتاب",
      "exampleTransliteration": "uʿṭīka l-kitāba",
      "exampleEnglish": "I give you the book.",
      "grammarNote": "أَعْطَى ('to give') is Form IV and defective (weak-final, root ع-ط-و) — like مَشَى (level 75), its present tense keeps a long ي, and 'you (fem.)' merges the root's ي with -ِينَ into one: تُعْطِينَ, not a doubled-up spelling. 'Give' is also special: it can take TWO objects with no preposition — أُعْطِيكَ الْكِتَابَ is literally 'I-give-you the-book', reusing the -كَ suffix from level 76 as the RECIPIENT rather than level 76's more general direct object.",
      "audio": { "id": "phrase_uteeka_alkitaab", "text": "أعطيك الكتاب" },
      "introducedInLevel": 87
    }
  ],
