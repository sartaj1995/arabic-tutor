  "patterns": [
    {
      "id": "train-arrives",
      "pattern": "الـ[Noun] + يَصِلُ",
      "exampleArabic": "يصل القطار",
      "exampleTransliteration": "yaṣilu l-qiṭāru",
      "exampleEnglish": "The train arrives.",
      "grammarNote": "وَصَلَ ('to arrive') reinforces level 93's assimilated (مِثَال) pattern rather than adding new grammar — its initial و also disappears in the present tense: وَصَلَ → يَصِلُ, not يَوْصِلُ. With اِنْطَلَقَ ('to depart', level 73), you can now describe a whole journey: يَنْطَلِقُ الْقِطَارُ ('the train departs') ... يَصِلُ الْقِطَارُ ('the train arrives').",
      "audio": { "id": "phrase_yasilu_alqitaar", "text": "يصل القطار" },
      "introducedInLevel": 98
    }
  ],
