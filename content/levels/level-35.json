  "patterns": [
    {
      "id": "ordinal-agreement",
      "pattern": "الـ[Noun] + الـ[Ordinal]",
      "exampleArabic": "اليوم الأول",
      "exampleTransliteration": "al-yawmu l-awwalu",
      "exampleEnglish": "the first day",
      "grammarNote": "Ordinals act as adjectives — they follow the noun and agree in definiteness, exactly like the colors from level 16: الْيَوْمُ الْأَوَّلُ ('the first day'), not الأول اليوم. Unlike cardinal numbers (one, two, three...), ordinals 1st-10th don't derive from the cardinals in a single predictable way — الْأَوَّل doesn't visibly relate to وَاحِد the way 'first' doesn't relate to 'one' in English either, so they're best learned as their own vocabulary. These are the masculine forms; feminine ordinals (needed for telling time) come next level.",
      "audio": { "id": "phrase_alyawm_alawwal", "text": "اليوم الأول" },
      "introducedInLevel": 35
    }
  ],
