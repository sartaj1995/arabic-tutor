  "patterns": [
    {
      "id": "imperative-command",
      "pattern": "[Imperative verb] + إِلَى + الـ[Place]",
      "exampleArabic": "اذهب إلى المدرسة",
      "exampleTransliteration": "idhhab ilā l-madrasati",
      "exampleEnglish": "Go to school!",
      "grammarNote": "The imperative is built from the jussive stem (the same stem لَمْ uses — level 32) with the تَـ/تَـ prefix stripped off, plus a helper vowel at the front so the word isn't unpronounceable: اِ- for most verbs (اِذْهَبْ, اِذْهَبِي — feminine just keeps the same ي ending as تَذْهَبِينَ), but اُ- when the verb's own vowel pattern is damma-type like كتب: اُكْتُبْ, not اِكْتُبْ. أَكَلَ ('to eat') is one of a small set of exceptions that drop the helper vowel entirely: كُلْ, not أُكُلْ — the same happens with أَخَذَ ('take') → خُذْ and أَمَرَ ('order') → مُرْ, not covered yet.",
      "audio": { "id": "phrase_idhhab_almadrasa", "text": "اذهب إلى المدرسة" },
      "introducedInLevel": 42
    }
  ],
