  "patterns": [
    {
      "id": "clothing-demonstrative",
      "pattern": "هَذَا + الـ[Noun] + [Color adjective]",
      "exampleArabic": "هذا القميص أحمر",
      "exampleTransliteration": "hādhā l-qamīṣu aḥmaru",
      "exampleEnglish": "This shirt is red.",
      "grammarNote": "A pure combination of things you already know: هَذَا + a definite noun (levels 5, 11) as the demonstrative sentence, plus a color adjective (level 16) as the predicate. Nothing new grammatically — the point of this level is the vocabulary: قَمِيص ('shirt'), حِذَاء ('shoes'), نَظَّارَة ('glasses'), حَقِيبَة ('bag'), and مَلَابِسُ ('clothes', a plural word for the whole category — notice it has no تَنْوِين, unlike most of the indefinite nouns you've seen; a handful of plural patterns like this one just don't take it).",
      "audio": { "id": "phrase_haadhaa_alqamees_ahmar", "text": "هذا القميص أحمر" },
      "introducedInLevel": 59
    }
  ],
