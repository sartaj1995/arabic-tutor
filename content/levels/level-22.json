  "patterns": [
    {
      "id": "past-go-place",
      "pattern": "[Time word] + [Past verb] + إِلَى + الـ[Place]",
      "exampleArabic": "أمس ذهبت إلى السوق",
      "exampleTransliteration": "amsi dhahabtu ilā s-sūqi",
      "exampleEnglish": "Yesterday I went to the market.",
      "grammarNote": "The past tense (الماضي) doesn't use the أَ-/تَ-/يَ-/نَ- prefixes you learned for the present tense — instead it attaches suffixes straight onto the root: -tu (I), -ta (you masc.), -ti (you fem.), -at (she), -nā (we), or nothing at all (he). Written without diacritics, ذَهَبْتُ، ذَهَبْتَ، ذَهَبْتِ، and ذَهَبَتْ all collapse to the identical written shape ذهبت — a real ambiguity even for fluent readers, resolved by context (a preceding subject like أَنَا or هِيَ) rather than the verb alone. ذَهَبَ (he) and ذَهَبْنَا (we) stay visually distinct either way. أَمْسِ ('yesterday') doesn't change form for case; غَدًا ('tomorrow') ends in tanwīn fatḥ (-an) because it's functioning as an adverb of time, same ending you saw on قَهْوَةً in level 15.",
      "audio": { "id": "phrase_amsi_dhahabtu_ila_alsuuq", "text": "أمس ذهبت إلى السوق" },
      "introducedInLevel": 22
    }
  ],
