  "patterns": [
    {
      "id": "body-part-agreement",
      "pattern": "[Body Part]ِي + [Fem. Adjective]",
      "exampleArabic": "يدي كبيرة",
      "exampleTransliteration": "yadī kabīratun",
      "exampleEnglish": "My hand is big.",
      "grammarNote": "يَد ('hand'), عَيْن ('eye'), and أُذُن ('ear') are irregularly feminine even though none of them end in ة — a small set of body-part and nature words work this way, and just have to be memorized alongside the word. Adjectives still have to agree: يَدِي كَبِيرَةٌ ('my hand is big'), with the feminine كَبِيرَة, not the masculine كَبِير you'd expect from a word with no ة. يَدِي applies the possessive ي- ending from level 9 to a new noun, same as جَدِّي did in level 28.",
      "audio": { "id": "phrase_yadi_kabiira", "text": "يدي كبيرة" },
      "introducedInLevel": 45
    }
  ],
