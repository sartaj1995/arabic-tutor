  "patterns": [
    {
      "id": "telling-time",
      "pattern": "السَّاعَةُ + الـ[Fem. Ordinal]",
      "exampleArabic": "الساعة الثالثة",
      "exampleTransliteration": "as-saaʿatu th-thaalithatu",
      "exampleEnglish": "It is three o'clock.",
      "grammarNote": "Telling time always uses the FEMININE ordinal, because سَاعَة ('hour/clock', level 3) is a feminine noun and the ordinal has to agree — the same adjective-agreement rule from level 4, now applied to ordinals instead of regular adjectives. Feminine ordinals mostly just add ة to last level's masculine form (الثالث → الثالثة), except الأول, whose feminine is irregular: الْأُولَى, not الْأَوَّلَة. So 'one o'clock' is السَّاعَةُ الْأُولَى, not a form based on الأول at all.",
      "audio": { "id": "phrase_alsaaa_althaalitha", "text": "الساعة الثالثة" },
      "introducedInLevel": 36
    }
  ],
