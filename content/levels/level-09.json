  "patterns": [
    {
      "id": "this-is-my-noun",
      "pattern": "[Demonstrative] + [Noun + Possessive Suffix]",
      "exampleArabic": "هَذَا بَيْتِي",
      "exampleTransliteration": "hādhā baytī",
      "exampleEnglish": "This is my house.",
      "grammarNote": "Possession is shown by attaching a suffix directly to the end of the noun, not with a separate word like English 'my'. Key suffixes: ـِي = my, ـُكَ = your (masc.), ـُكِ = your (fem.), ـُهُ = his, ـُهَا = her. A noun with a possessive suffix is definite, so it drops the indefinite tanwīn ending (بَيْتٌ → بَيْتِي, not بَيْتٌي).",
      "audio": { "id": "phrase_haadhaa_baytii", "text": "هَذَا بَيْتِي" },
      "introducedInLevel": 9
    }
  ],
