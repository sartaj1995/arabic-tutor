  "patterns": [
    {
      "id": "month-sentence",
      "pattern": "أَنَا فِي + [Month]",
      "exampleArabic": "أنا في يناير",
      "exampleTransliteration": "anā fī yanāyir",
      "exampleEnglish": "I am in January.",
      "grammarNote": "These twelve names are the internationally recognized Gregorian months used across most modern Arabic media and official contexts — Arabized versions of the same names you already know, not translated. (The Levant region also uses a separate, older set of Aramaic-derived names for the same months; those aren't covered here.) Grammatically there's nothing new: أَنَا فِي + [month] reuses فِي exactly as level 5 introduced it. شَهْر ('a month') is the generic noun the way يَوْم ('a day', level 17) works for days of the week.",
      "audio": { "id": "phrase_ana_fi_yanayir", "text": "أنا في يناير" },
      "introducedInLevel": 65
    }
  ],
