  "patterns": [
    {
      "id": "walk-to-school",
      "pattern": "[Verb] + إِلَى الـ[Place]",
      "exampleArabic": "أمشي إلى المدرسة",
      "exampleTransliteration": "amshī ilā l-madrasati",
      "exampleEnglish": "I walk to school.",
      "grammarNote": "مَشَى ('to walk') is your first 'defective' (weak-final) verb — a root whose LAST letter is و or ي, a third kind of weak-verb irregularity alongside hollow, middle-weak verbs like أَرَادَ/نَامَ (levels 15, 66). In the present tense it mostly behaves like an ordinary Form I verb with a long ي wherever the root's ي would be: أَمْشِي, تَمْشِي, يَمْشِي, نَمْشِي. The one real wrinkle is 'you (fem.)': the root's final ي and the -ِينَ suffix's own ي merge into a single ي rather than stacking two — تَمْشِينَ, not the doubled-up تَمْشِيِينَ you might expect by analogy with تَذْهَبِينَ.",
      "audio": { "id": "phrase_amshi_ilaa_almadrasa", "text": "أمشي إلى المدرسة" },
      "introducedInLevel": 75
    }
  ],
