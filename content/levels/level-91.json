  "patterns": [
    {
      "id": "i-see-the-moon",
      "pattern": "[Verb] + الـ[Noun]",
      "exampleArabic": "أرى القمر",
      "exampleTransliteration": "arā l-qamara",
      "exampleEnglish": "I see the moon.",
      "grammarNote": "رَأَى ('to see') is one of Arabic's most irregular verbs — the root's middle hamza simply DROPS in the present tense: you'd expect يَرْأَى, but it's actually يَرَى. Once the hamza is gone, what's left behaves like a defective (weak-final) verb, the same family as مَشَى (level 75): أَرَى, تَرَى, تَرَيْنَ, يَرَى, نَرَى. This is the last of the irregular verb patterns in this course — a fitting one to end on, given how essential 'to see' is.",
      "audio": { "id": "phrase_ara_alqamar", "text": "أرى القمر" },
      "introducedInLevel": 91
    }
  ],
